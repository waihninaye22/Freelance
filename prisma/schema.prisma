generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String
  passwordHash          String
  isAdmin               Boolean              @default(false)
  isActive              Boolean              @default(true)
  freelancerProfile     FreelancerProfile?
  clientProfile         ClientProfile?
  jobs                  Job[]                @relation("ClientJobs")
  proposals             Proposal[]           @relation("FreelancerProposals")
  savedJobs             SavedJob[]
  clientProjects        Project[]             @relation("ClientProjects")
  freelancerProjects    Project[]             @relation("FreelancerProjects")
  sentMessages          ProjectMessage[]
  notifications         Notification[]
  reviewsGiven          Review[]               @relation("ReviewAuthor")
  reviewsReceived       Review[]               @relation("ReviewRecipient")
  reports               Report[]               @relation("ReportAuthor")
  adminEvents           AdminAuditEvent[]      @relation("AdminActor")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model FreelancerProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline       String?
  bio            String?
  location       String?
  timeZone       String?
  hourlyRateMinor Int?
  rateCurrency   String?
  skills         FreelancerSkill[]
  portfolioLinks PortfolioLink[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  description String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioLink {
  id         String            @id @default(cuid())
  profileId  String
  profile    FreelancerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label      String
  url        String
  createdAt  DateTime          @default(now())
}

model Skill {
  id          String             @id @default(cuid())
  name        String             @unique
  freelancerProfiles FreelancerSkill[]
  jobSkills   JobSkill[]
}

model FreelancerSkill {
  profileId String
  skillId   String
  profile   FreelancerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  jobs Job[]
}

model Job {
  id             String      @id @default(cuid())
  clientId       String
  client         User        @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Restrict)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String
  description    String
  budgetType     String      // fixed | hourly
  minAmountMinor Int?        // USD cents; MMK whole kyat
  maxAmountMinor Int?
  currency       String      // USD | MMK
  experienceLevel String?
  status         String      @default("draft") // draft | open | paused | closed
  skills         JobSkill[]
  proposals      Proposal[]
  savedBy        SavedJob[]
  project        Project?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([currency, budgetType, status])
}

model JobSkill {
  jobId   String
  skillId String
  job     Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model SavedJob {
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

model Proposal {
  id                    String   @id @default(cuid())
  jobId                 String
  job                   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId          String
  freelancer            User     @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Restrict)
  coverMessage          String
  amountMinor           Int
  currency              String
  estimatedDurationDays Int?
  status                String   @default("pending") // pending | shortlisted | rejected | withdrawn | hired
  project               Project?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([jobId, freelancerId])
  @@index([jobId, status, createdAt])
  @@index([freelancerId, status, createdAt])
}

model Project {
  id           String           @id @default(cuid())
  jobId        String           @unique
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposalId   String           @unique
  proposal     Proposal         @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  clientId     String
  client       User             @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  freelancerId String
  freelancer   User             @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: Restrict)
  scopeSummary String
  amountMinor  Int
  currency     String
  status       String           @default("active") // active | submitted | completed | cancelled | cancellation_requested
  messages     ProjectMessage[]
  reviews      Review[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId, status, updatedAt])
  @@index([freelancerId, status, updatedAt])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  recipientId String
  recipient   User     @relation("ReviewRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  rating      Int
  body        String?
  createdAt   DateTime @default(now())

  @@unique([projectId, authorId])
  @@index([recipientId, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Restrict)
  targetType  String
  targetId    String
  reason      String
  details     String?
  status      String   @default("pending")
  reviewedBy  String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model AdminAuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
}
